<%-- 管理系画面共通ナビゲーション。currentPage リクエスト属性でアクティブタブを判定する。
     不適切監査ビュー・区市町村案内文・オープンデータ公表は政策企画局（総合窓口）専用のため、
     それ以外の局アカウントには表示しない（アクセス制御自体はGeneralDeskOnlyFilterで行う）。

     このフラグメント自体に pageEncoding を明記しておく必要がある — <%@ include %>（静的インクルード）で
     取り込まれる際、これが無いとJasperがこのファイルをUTF-8以外（既定/ISO-8859-1相当）として
     解釈し、この中の日本語リテラルだけが文字化けする不具合が実際に発生したため。 --%>
<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.tominnokoe.security.BureauAccountRegistry" %>
<%@ page import="com.tominnokoe.admin.web.filter.AdminAuthFilter" %>
<%
    String sessionBureau = (String) session.getAttribute(AdminAuthFilter.SESSION_KEY);
    boolean isGeneralDesk = BureauAccountRegistry.isGeneralDesk(sessionBureau);
    request.setAttribute("navSessionBureau", sessionBureau);
%>
<header class="site-header">
  <p class="site-title"><a href="<%=request.getContextPath()%>/admin" style="color:#fff; text-decoration:none;">都民の声総合窓口DX化（管理画面）</a></p>
</header>
<nav class="admin-nav">
  <a href="<%=request.getContextPath()%>/admin" class="<%="dashboard".equals(request.getAttribute("currentPage")) ? "active" : ""%>">メニュー</a>
  <a href="<%=request.getContextPath()%>/admin/triage" class="<%="triage".equals(request.getAttribute("currentPage")) ? "active" : ""%>">案件一覧</a>
  <a href="<%=request.getContextPath()%>/admin/manual-intake" class="<%="manual-intake".equals(request.getAttribute("currentPage")) ? "active" : ""%>">電話・FAX・窓口 代筆入力</a>
  <% if (isGeneralDesk) { %>
  <a href="<%=request.getContextPath()%>/admin/inappropriate" class="<%="inappropriate".equals(request.getAttribute("currentPage")) ? "active" : ""%>">不適切監査ビュー</a>
  <% } %>
  <a href="<%=request.getContextPath()%>/admin/governance" class="<%="governance".equals(request.getAttribute("currentPage")) ? "active" : ""%>">通知・進捗管理</a>
  <% if (isGeneralDesk) { %>
  <a href="<%=request.getContextPath()%>/admin/guidance" class="<%="guidance".equals(request.getAttribute("currentPage")) ? "active" : ""%>">区市町村案内文</a>
  <a href="<%=request.getContextPath()%>/admin/opendata" class="<%="opendata".equals(request.getAttribute("currentPage")) ? "active" : ""%>">オープンデータ公表</a>
  <% } %>
  <span style="margin-left:auto; padding: 12px 14px; color: var(--muted); font-size: 13px;">
    <c:out value="${navSessionBureau}"/>
    <a href="<%=request.getContextPath()%>/admin/logout" style="margin-left:8px;">ログアウト</a>
  </span>
</nav>
